{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biva.vn/schemas/kb/features.schema.json",
  "title": "Danh mục feature logic L1 (kb/L1/<ngành>/features.yaml)",
  "description": "Nạp vào bảng logic_features bởi brain-api kb sync. Feature dùng so khớp nhà xe theo logic (find_similar_operators).",
  "type": "object",
  "additionalProperties": false,
  "required": ["industry", "features"],
  "properties": {
    "industry": {"type": "string", "minLength": 1},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
            "description": "<capability>.<tên>, vd fare.holiday_surcharge — tiền tố phải trùng capability"
          },
          "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "description": {"type": "string", "minLength": 1},
          "params_schema": {
            "type": "object",
            "description": "mô tả tham số của feature (JSON Schema con, tối giản)"
          }
        }
      }
    }
  }
}
