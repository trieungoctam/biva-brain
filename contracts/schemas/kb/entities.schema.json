{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biva.vn/schemas/kb/entities.schema.json",
  "title": "Từ điển thực thể + alias của ngành (kb/L1/<ngành>/entities.yaml)",
  "description": "Dùng cho entity resolution: 'SG', 'Sài Gòn', 'TP.HCM' → một thực thể. Alias so khớp sau textnorm (không dấu, không phân biệt hoa thường); một alias chỉ được thuộc một thực thể.",
  "type": "object",
  "additionalProperties": false,
  "required": ["industry", "entities"],
  "properties": {
    "industry": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "name"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "type": {"enum": ["city", "station", "vehicle_type", "place"]},
          "name": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
