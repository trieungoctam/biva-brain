{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biva.vn/schemas/llm_config.schema.json",
  "title": "Cấu hình thư viện llm/ (contracts/llm/llm.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "providers", "models", "tiers", "purposes"],
  "properties": {
    "version": {"const": 1},
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "api_key_env"],
        "properties": {
          "kind": {"enum": ["anthropic"]},
          "api_key_env": {"type": "string", "minLength": 1},
          "base_url_env": {"type": "string"},
          "timeout_s": {"type": "number", "exclusiveMinimum": 0},
          "max_retries": {"type": "integer", "minimum": 0, "maximum": 5}
        }
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "price"],
        "properties": {
          "provider": {"type": "string"},
          "effort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
          "server_fallback": {"type": "boolean"},
          "price": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "output"],
            "properties": {
              "input": {"type": "number", "minimum": 0},
              "output": {"type": "number", "minimum": 0},
              "cache_read": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "tiers": {
      "type": "object",
      "required": ["small", "strong"],
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
    },
    "purposes": {
      "type": "object",
      "required": ["ingest", "knowledge", "validate", "test", "interactive"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "tokens_per_minute", "requests_per_minute"],
        "properties": {
          "tier": {"type": "string"},
          "tokens_per_minute": {"type": "integer", "minimum": 1},
          "requests_per_minute": {"type": "integer", "minimum": 1},
          "effort": {"enum": ["low", "medium", "high", "xhigh", "max"]}
        }
      }
    }
  }
}
